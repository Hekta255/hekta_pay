RewriteEngine On

# Pass the Pub/Sub bearer token through to PHP.

RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Never serve runtime configuration or hidden files.

RewriteRule ^\.env(?:\.|$) - [F,L]
RewriteRule (^|/)\. - [F,L]

# Keep the application source directory outside the public route surface.

RewriteRule ^src(?:/|$) - [F,L]

# Route API and health requests through the front controller.

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

Options -Indexes
